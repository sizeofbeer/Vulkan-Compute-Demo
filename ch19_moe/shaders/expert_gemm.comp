#version 450
// ch19_moe/shaders/expert_gemm.comp
// Batched expert GEMM: C = A * W  (for one expert)
//
// A: [num_tokens, K]  — token activations (all tokens, but only the ones
//                        assigned to this expert will contribute meaningfully)
// W: [num_experts, K, N]  — expert weight matrices, flattened
// C: [num_tokens, N]  — output for this expert
//
// Uses shared memory 2D tiling (16x16 tiles) — same technique as ch04.
//
// Push constants:
//   num_tokens  — number of tokens (M)
//   N           — output dimension
//   K           — input dimension
//   expert_id   — which expert to use (indexes into the weight buffer)

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer TokenActivations {
    float act[];   // [num_tokens, K]
};

layout(std430, binding = 1) readonly buffer ExpertWeights {
    float wt[];    // [num_experts, K, N]
};

layout(std430, binding = 2) writeonly buffer ExpertOutput {
    float res[];   // [num_tokens, N]
};

layout(push_constant) uniform PC {
    uint num_tokens;
    uint N;
    uint K;
    uint expert_id;
};

// Shared memory tiles for A and B
shared float As[16][16];
shared float Bs[16][16];

void main() {
    uint row = gl_GlobalInvocationID.y;  // C row (token index)
    uint col = gl_GlobalInvocationID.x;  // C column (output dim index)
    uint lrow = gl_LocalInvocationID.y;
    uint lcol = gl_LocalInvocationID.x;

    if (row >= num_tokens || col >= N) return;

    // Base offset into the weight buffer for this expert
    uint wtBase = expert_id * K * N;

    float acc = 0.0f;
    uint numTiles = (K + 15u) / 16u;

    for (uint t = 0u; t < numTiles; ++t) {
        // ── Load tile of A ──
        uint aCol = t * 16u + lcol;
        As[lrow][lcol] = (aCol < K) ? act[row * K + aCol] : 0.0f;

        // ── Load tile of B (expert-specific) ──
        uint bRow = t * 16u + lrow;
        Bs[lrow][lcol] = (bRow < K)
            ? wt[wtBase + bRow * N + col]
            : 0.0f;
        barrier();

        // ── Compute partial dot product over this tile ──
        for (uint k = 0u; k < 16u; ++k) {
            acc += As[lrow][k] * Bs[k][lcol];
        }
        barrier();
    }

    // 输出 buffer 布局为 [expert_id][num_tokens][N]，需加上本专家的偏移
    res[expert_id * num_tokens * N + row * N + col] = acc;
}