#version 450
// 逐元素算子（本章用作 ReLU 节点，mode=0）。详见 ch06。
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Inp { float x[]; };
layout(std430, binding = 1) writeonly buffer Out { float y[]; };
layout(push_constant) uniform PC { uint n; uint mode; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= n) return;
    float v = x[i];
    float r = (mode == 0u) ? ((v > 0.0f) ? v : 0.0f) : v;   // 本章只用 ReLU
    y[i] = r;
}
